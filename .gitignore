# Generated by XcodeGen - regenerate with `xcodegen generate`, never commit it.
Meridian.xcodeproj/
*.xcworkspace/

# Build output
build/
out/
DerivedData/
*.xcarchive
*.dSYM/
*.ipa
*.app/

# Logs and local reports
*.log
*.xcresult/

# Swift Package Manager (unused today, ignored if it appears)
.build/
.swiftpm/
Package.resolved

# Node
node_modules/
npm-debug.log*

# Python
__pycache__/
*.pyc
.venv/
venv/

# Icon generation scratch
Tools/icon-preview.png

# Server runtime state - one JSON file per deployment, never in the repo
server/data.json
server/data/
server/*.json.tmp

# macOS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Deploy-time artefacts: one set per deployment, never shared
deploy/portal/version.json
deploy/portal/meridian-source.json
deploy/portal/files/